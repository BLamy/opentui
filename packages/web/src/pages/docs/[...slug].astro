---
import { getCollection } from "astro:content"
import { documentOutline, parseMarkdown } from "@brett_lamy/docstream/gitbook"
import DocstreamContent from "../../components/DocstreamContent.astro"
import Docs from "../../layouts/Docs.astro"
import { buildChannels, channelUrl, docsRouteParam, pageChannel } from "../../lib/docs-channel"
import { buildDocsIndex } from "../../lib/docs-index"
import { docstreamParts } from "../../lib/docstream-markdown"

export async function getStaticPaths() {
  const [docs, docsIndex] = await Promise.all([getCollection("docs"), buildDocsIndex()])
  const entriesById = Object.fromEntries(docs.map((entry) => [entry.id, entry]))

  return buildChannels().flatMap((channel) =>
    docsIndex.pages.map((page) => ({
      params: { slug: docsRouteParam(channelUrl(page.url, channel)) },
      props: { entry: entriesById[page.sourceId], page },
    })),
  )
}

const { entry, page } = Astro.props
if (!entry || !page) throw new Error("Missing documentation route entry")
const base = process.env.OPENTUI_SITE_BASE
const parts = docstreamParts(entry.body ?? "", pageChannel(Astro.url.pathname), base ? new URL(`${base}/`, Astro.site).href : undefined)
const headings = parts.flatMap((part) => part.type === "markdown"
  ? documentOutline(parseMarkdown(part.markdown)).map(({ level, id, text }) => ({ depth: level, slug: id, text }))
  : [])
---

<Docs title={entry.data.title} description={entry.data.description} slug={page.slug} headings={headings}>
  <DocstreamContent {parts} />
</Docs>
